# Kopyalayın: cp .env.example .env  — .env dosyası repoya girmez.
PORT=3300
HOST=127.0.0.1
# APP_USER=admin
# APP_PASS=
# Sunucuyu bir alan adı ile açarsanız adı yazın (virgül ile ayırın). localhost ve IP adresi için gerekmez.
# ALLOWED_HOSTS=seo.ofis.example
# Yayın (Render): PUBLIC_MODE=1 iç ağ adreslerini engeller ve yayın limitlerini açar. Şifre isteğe bağlıdır.
# PUBLIC_MODE=1
# EPHEMERAL_STORAGE=1
# v0.13.0: JavaScript render. Chromium kurulumu: npx playwright-core install chromium-headless-shell
# Kurulu Chrome kullanmak için yolunu yazın (denenmedi, Playwright sürümü ile uyumsuz olabilir):
# CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Sprint 4: ANTHROPIC_API_KEY=
# Sprint 5: PSI_API_KEY=  CLICKUP_TOKEN=
